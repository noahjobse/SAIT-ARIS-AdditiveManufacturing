start: module+

// RAPID files consist of at least one module. 
// The internal hierarchy is module -> procedure -> statement -> terminal

module: "MODULE" IDENTIFIER procedure* "ENDMODULE"
procedure: "PROC" IDENTIFIER "()" statement* "ENDPROC"
statement: move_l | move_j | move_c

// These are our movements commands.
// Each movement commands needs a target, speed, zone, tool. Work objects are optional (defined by the brackets [])

move_l: "MoveL" target "," speed "," zone "," tool ["," wobj] ";"
move_j: "MoveJ" target "," speed "," zone "," tool ["," wobj] ";"
move_c: "MoveC" cir_point "," target "," speed "," zone "," tool ["," wobj] ";"

// These are our arguments that define the values inside each movement command.
// Each can be defined either by a variable name or inline data

target: IDENTIFIER | robtarget
cir_point: IDENTIFIER | robtarget
speed: IDENTIFIER | speeddata
zone: IDENTIFIER | zonedata
tool: IDENTIFIER
wobj: "\\WObj" ":=" IDENTIFIER


// "robtarget" is our primary coordinate type. Structured as:
// [position, rotation, configuration, external_axes]
// each of these individual data structures are then defined below

robtarget: "[" pos "," rot "," confdata "," extax "]"
pos: "[" NUMBER "," NUMBER "," NUMBER "]"
rot: "[" NUMBER "," NUMBER "," NUMBER "," NUMBER "]"
confdata: "[" NUMBER "," NUMBER "," NUMBER "," NUMBER "]"
extax: "[" NUMBER "," NUMBER "," NUMBER "," NUMBER "," NUMBER "," NUMBER "]"

// Placeholders for other data types (simplified for MVP, we can expand on this later) 

speeddata: "[" NUMBER "," NUMBER "," NUMBER "," NUMBER "]"
zonedata: "[" BOOLEAN "," NUMBER "," NUMBER "," NUMBER "," NUMBER "," NUMBER "]"

// IDENTIFIER starts with a letter, followed by letters or numbers
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

// NUMBER matches integers, decimals, and scientific notation.
NUMBER: /-?\d+(\.\d+)?([eE][+-]?\d+)?/

// BOOLEAN matches true or false values
BOOLEAN: "TRUE" | "FALSE"

// COMMENT starts with a "!" and ignores everything until the end of the line.
COMMENT: "!" /[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT

