{
  "name": "abb-sim-frontend",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
