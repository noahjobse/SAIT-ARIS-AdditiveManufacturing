# Create .gitkeep files so empty folders are tracked

$folders = @(
  "phase-1\baseline-station",
  "phase-1\rapid",
  "phase-1\evidence\tg1",
  "phase-1\evidence\tg2",
  "phase-1\evidence\rocket-v1",
  "phase-1\evidence\rocket-v2",
  "phase-2",
  "phase-3"
)

foreach ($f in $folders) {
  $path = Join-Path (Get-Location) $f
  New-Item -ItemType Directory -Force -Path $path | Out-Null
  New-Item -ItemType File -Force -Path (Join-Path $path ".gitkeep") | Out-Null
}

Write-Host ".gitkeep files created"
