<?xml version="1.0"?>
<robot name="irb6700">

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.2" length="0.4"/></geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Link 1 -->
  <link name="link_1">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.3"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.15" length="0.6"/></geometry>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 1: Base rotation -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.78" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.967" upper="2.967" effort="100" velocity="1.920"/>
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.5625"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="1.125"/></geometry>
      <origin xyz="0 0 0.5625" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 2: Shoulder -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.134" upper="1.484" effort="100" velocity="1.920"/>
  </joint>

  <!-- Link 3 -->
  <link name="link_3">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.1" length="0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 3: Elbow -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 1.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.142" upper="1.222" effort="100" velocity="1.920"/>
  </joint>

  <!-- Link 4 -->
  <link name="link_4">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0.57125 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.08" length="1.1425"/></geometry>
      <origin xyz="0.57125 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 4: Wrist roll -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-5.236" upper="5.236" effort="100" velocity="3.316"/>
  </joint>

  <!-- Link 5 -->
  <link name="link_5">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 5: Wrist pitch -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="1.1425 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.269" upper="2.269" effort="100" velocity="2.618"/>
  </joint>

  <!-- Link 6 (Tool flange) -->
  <link name="link_6">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.05" length="0.1"/></geometry>
      <origin xyz="0.05 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 6: Wrist yaw -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.283" upper="6.283" effort="100" velocity="3.665"/>
  </joint>

  <!-- Tool Center Point (TCP) -->
  <link name="tool0"/>
  <joint name="joint_6-tool0" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
