<?xml version="1.0"?>
<robot name="irb2600">

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.12" length="0.25"/></geometry>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Link 1 -->
  <link name="link_1">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.2"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.08" length="0.4"/></geometry>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 1: Base rotation -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.445" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.054"/>
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.35"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.08" length="0.7"/></geometry>
      <origin xyz="0 0 0.35" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 2: Shoulder -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.705" upper="1.658" effort="100" velocity="3.054"/>
  </joint>

  <!-- Link 3 -->
  <link name="link_3">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.06" length="0.12"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- Joint 3: Elbow -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.7" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.705" upper="1.309" effort="100" velocity="3.054"/>
  </joint>

  <!-- Link 4 -->
  <link name="link_4">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0.4 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.05" length="0.795"/></geometry>
      <origin xyz="0.4 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 4: Wrist roll -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.115" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.981" upper="6.981" effort="100" velocity="6.283"/>
  </joint>

  <!-- Link 5 -->
  <link name="link_5">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 5: Wrist pitch -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.795 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="2.094" effort="100" velocity="6.283"/>
  </joint>

  <!-- Link 6 (Tool flange) -->
  <link name="link_6">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <collision>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
    </collision>
  </link>

  <!-- Joint 6: Wrist yaw -->
  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.085 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-6.981" upper="6.981" effort="100" velocity="8.727"/>
  </joint>

  <!-- Tool Center Point (TCP) -->
  <link name="tool0"/>
  <joint name="joint_6-tool0" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
